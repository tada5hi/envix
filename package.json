{
    "name": "envix",
    "version": "1.5.0",
    "description": "",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/envix.git"
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:js": "tsdown",
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:js",
        "build:watch": "tsdown --watch",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.mts",
        "test:coverage": "npm test -- --coverage",
        "lint": "eslint src AGENTS.md CLAUDE.md .agents",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "husky install"
    },
    "keywords": [],
    "license": "MIT",
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.1.7",
        "@tada5hi/eslint-config": "^3.3.1",
        "@tada5hi/tsconfig": "^0.5.0",
        "@types/node": "^24.10.1",
        "@vitest/coverage-v8": "^5.1.0",
        "cross-env": "^7.0.3",
        "eslint": "^10.14.0",
        "husky": "^9.0.11",
        "lint-staged": "^17.6.0",
        "tsdown": "^0.23.7",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "lint-staged": {
        ".js": "npm run lint:fix",
        "*.ts": "npm run lint:fix"
    },
    "dependencies": {
        "std-env": "^3.7.0"
    }
}
