{
    "name": "envix",
    "version": "2.0.0",
    "description": "Read environment variables as numbers, booleans and lists, with typed fallbacks.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/envix.git"
    },
    "type": "module",
    "main": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build:types": "tsc -p test/tsconfig.json",
        "build:js": "tsdown",
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:types && npm run build:js",
        "build:watch": "tsdown --watch",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.mts",
        "test:coverage": "npm test -- --coverage",
        "lint": "eslint src AGENTS.md CLAUDE.md .agents",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "husky"
    },
    "keywords": [],
    "license": "MIT",
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.3",
        "@tada5hi/eslint-config": "^3.3.1",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.1.1",
        "cross-env": "^10.1.0",
        "eslint": "^10.15.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.1",
        "tsdown": "^0.23.7",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "^5.1.1"
    },
    "lint-staged": {
        ".js": "npm run lint:fix",
        "*.ts": "npm run lint:fix"
    },
    "dependencies": {
        "@ebec/core": "^1.3.2"
    }
}
